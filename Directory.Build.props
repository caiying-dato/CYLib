<Project>
    <PropertyGroup>
        <!--
          游戏是 net9.0，模组也必须一致。
          本机系统 dotnet 已带 net9.0 targeting pack，可直接编译 net9.0。
          若换到只装了旧 SDK 的机器，把 LocalDotnetRoot 指到那份 SDK 目录即可。
        -->
        <LocalDotnetRoot Condition="'$(LocalDotnetRoot)' == ''">$(USERPROFILE)\.dotnet</LocalDotnetRoot>
        <NetCoreTargetingPackRoot Condition="'$(NetCoreTargetingPackRoot)' == ''">$(LocalDotnetRoot)\packs</NetCoreTargetingPackRoot>

        <!-- Godot 4.5.1 mono 可执行文件，仅需要 Godot 导出兜底时使用（默认走 PckPacker）。 -->
        <GodotPath Condition="'$(GodotPath)' == ''"></GodotPath>
    </PropertyGroup>

    <!-- 本机路径覆盖。从 local.props.template 复制一份 local.props 再改。 -->
    <Import Project="local.props" Condition="Exists('local.props')" />
</Project>
