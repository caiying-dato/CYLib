# 构建输出
bin/
obj/
out/

# Godot 生成的中间产物
.godot/

# 本机专属路径配置（换机器时各人自己写）
local.props
*.user

# 离线 NuGet 包源。刻意不入库：4.9 MB 的 .nupkg，其中几个是第三方包，
# 不入库更干净；nuget.config 里 nuget.org 是补充源，真正需要的两个包
# （BSchneppe.StS2.PckPacker、Krafs.Publicizer）都能从 nuget.org 还原。
packages/

# IDE
.vs/
.idea/

# 发布打包的暂存目录
release/_stage/

# 上传器运行时偶尔会在当前目录写日志（本机跑 ModUploader 时误落进来的）
mod-uploader.log

# ─────────────────────────────────────────────────────────────
# 刻意**保留在版本控制**里的目录（不要加进来）：
#
#   dist/     模组构建产物。保留它，模组从游戏里卸载后可以不重新编译就装回去。
#   release/  发布包。保留它，方便直接上传 GitHub Releases 而不必重跑构建。
#
# ─────────────────────────────────────────────────────────────

# 临时文件
*.tmp
